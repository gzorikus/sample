{
    "ConnectionStrings": {
        "Npgsql": "Host=localhost;Port=5432;Database=YourCompanyDemoDatabase;Username=YourCompanyDemoUser;SearchPath=efcore-migrations",
        "Sqlite": "Data Source=path-to-file.db"
    },
    "YourCompany": {
        "EFCore": {
            "EnableDetailedErrors": true,
            "EnableSensitiveDataLogging": true,
            "PluginPaths": [
                "YourCompany.EFCore.dll",
